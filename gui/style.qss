
QWidget#m_mainWidget{
    border-radius:10px;
    background-color:#FFFFFF;
}

QWidget#titleBar {
    color:#0a0c0f;
    background-color: #5ea6f2;
    border-top-left-radius:10px;
    border-top-right-radius:10px;
    border:none;
}

QWidget#titleBar QPushButton {
    color:#ffffff;
    margin:0;
    text-align:center;
    background-color: #5ea6f2;
    border-radius:0;
    font-size:18px;
}

QWidget#titleBar QPushButton#closeBtn {
    border-top-right-radius:10px;
}

QWidget#titleBar QPushButton#closeBtn:hover  {
    background-color:#ff8474;
}

QWidget#titleBar QPushButton:hover {
    background-color:#94dcff;
}

QWidget#titleBar QLabel {
    color:#ffffff;
    font-size:11px;
    font-weight:bold;
    margin:0;
    border:none;
}

QWidget#colonneGauche,
QWidget#leftContainer {
    border-bottom-left-radius:10px;
    background-color: #FFFFFF;
}



QMenuBar {
    background-color: #FFFFFF;
    color:#0a0c0f;
}

QMenuBar#menuBar::item {
    background-color:#ffffff;
    border-radius:5px;
    padding:8px 18px;
    margin:5px 5px 0 5px;
}

QMenuBar#menuBar::item:selected {
    background-color:#f5f7fa;
}



QWidget#colonneGauche QLineEdit,
QWidget#colonneGauche QComboBox {
    margin:4px 10px 4px 0;
    background-color:#f5f7fa;
    color:#0a0c0f;
    padding:5px 10px;
    border-radius:5px;
    border: none;
    font-size:14px;
}

QWidget#colonneGauche QLineEdit {
    width:180px;
}
QWidget#colonneGauche QComboBox { width:161px}


QWidget#colonneGauche QComboBox::down-arrow {
    image: url("../../../gui/ressources/arrow_down.png");
    width:6px;
    height:6px;
}

QWidget#colonneGauche QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    margin-right:15px;
    border: none;
}

QComboBox QAbstractItemView {
    background: #f5f7fa;
    color:#0a0c0f;
    border: none;
    selection-background-color: #deebf9;
    outline:0;
}

QComboBox QAbstractItemView::item:focus {
    outline: none;
    border: none;
}

QComboBox QAbstractItemView::item {
    padding:2px;
    border:none;
    background: #f5f7fa;
    outline:0;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #deebf9;
    border:none;
    outline:0;
}



QWidget#colonneGauche QComboBox::down-arrow:on {
    image: url("../../../gui/ressources/arrow_up.png");
}

QWidget#colonneGauche QCheckBox {
    margin:4px 0 4px 30px;
    right:0;
}

QWidget#colonneGauche QCheckBox::indicator {
    width:90px;
    height:30px;
}

QWidget#colonneGauche QCheckBox::indicator:unchecked {
    image: url("../../../gui/ressources/checkbox_off.png");
}

QWidget#colonneGauche QCheckBox::indicator:checked {
    /* background-color:#5ea6f2; */
    image: url("../../../gui/ressources/checkbox_on.png");
}

QWidget#colonneGauche QLabel {
    margin:4px 0px 4px 10px;
    color:#0a0c0f;
    font-size:14px;
}

QWidget#mainArea {
    background-color: #f5f7fa;
    border-bottom-right-radius:10px;
}

QPushButton#runBtn {
    background-color: #5ea6f2;
    padding:15px 30px;
    color:#ffffff;
    font-size:20px;
    border-radius:10px;
    /* background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(246,79,89,1),
        stop:0 rgba(196,113,237,1),
        stop:0.01 rgba(18,166,242,1)
    ); */
}

QPushButton#runBtn:hover {
    background-color:#94dcff;
    /*background: qlineargradient(
        spread:pad,
        x1:0, y1:0, x2:1, y2:1,
        stop:0 rgba(246,79,89,1),
        stop:0.5 rgba(196,113,237,1),
        stop:0.92 rgba(18,166,242,1)
    ); */
}

QToolButton#chooseFileButton {
    background-color: #deebf9;
    padding:100px 220px;
    color:#5ea6f2;
    font-size:22px;
    font-weight:800;
    border-radius:40px;
    border: 4px dashed #5ea6f2;
    text-align:center;
    qproperty-iconSize : 80px 80px;
    max-width:200px;
}

QToolButton#chooseFileButton:hover {
    background-color: #c7dff8;
}